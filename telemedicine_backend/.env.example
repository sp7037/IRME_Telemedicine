# Copy this file to .env for local development.
# Do not commit real passwords or production secrets.

DEBUG=True
FRONTEND_BASE_URL=http://localhost:3000

# Local default prints emails in the Django runserver console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# To send real emails locally or in production, switch to SMTP and fill these.
# For Gmail, use an App Password, not your normal account password.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_gmail_app_password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=IRME Telemedicine <your_email@gmail.com>
MARKETING_LEAD_EMAIL=your_leads_email@example.com
MARKETING_CALLBACK_IP_LIMIT=8
MARKETING_CALLBACK_IP_WINDOW_SECONDS=3600
MARKETING_CALLBACK_PHONE_DAILY_LIMIT=3

# Razorpay payment gateway.
# Add real values in telemedicine_backend/.env locally, or as cloud environment variables in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional video provider configuration.
# Keep real API tokens in telemedicine_backend/.env or cloud environment variables only.
VIDEO_PROVIDER=cloudflare

# Cloudflare RealtimeKit embedded video meetings.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_CALLS_APP_ID=your_realtimekit_app_id
CLOUDFLARE_REALTIMEKIT_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_PRESET_DOCTOR=group_call_host
CLOUDFLARE_PRESET_PATIENT=group_call_participant
CLOUDFLARE_PRESET_TMC=group_call_participant

# Legacy Dyte fallback only. Leave blank when VIDEO_PROVIDER=cloudflare.
DYTE_ORGANIZATION_ID=
DYTE_API_KEY=
DYTE_BASE_URL=https://api.dyte.io/v2
DYTE_PRESET_DOCTOR=group_call_host
DYTE_PRESET_PATIENT=group_call_participant
DYTE_PRESET_TMC=group_call_participant
