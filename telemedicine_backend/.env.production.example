# Configure these as AIC Cloud runtime environment variables; never commit populated values.
DJANGO_SETTINGS_MODULE=telemedicine_project.production_settings
DEPLOYMENT_STAGE=staging
SECRET_KEY=replace-with-a-new-random-secret-at-least-50-characters
ALLOWED_HOSTS=telemedicine.irme.in
FRONTEND_BASE_URL=https://telemedicine.irme.in
CSRF_TRUSTED_ORIGINS=https://telemedicine.irme.in
CORS_ALLOWED_ORIGINS=https://telemedicine.irme.in
DB_NAME=replace-database-name
# Alternatively set DATABASE_URL in AIC Cloud secrets; it takes precedence over the DB_* connection fields.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_USER=replace-database-user
DB_PASSWORD=replace-database-password
DB_HOST=replace-database-host
DB_PORT=5432
DB_SSLMODE=require
# AIC app disks are ephemeral. Keep uploads in a PRIVATE external bucket.
UPLOAD_STORAGE=s3
S3_ENDPOINT_URL=https://replace-storage-endpoint
S3_BUCKET_NAME=replace-private-bucket
S3_REGION_NAME=replace-region
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ADDRESSING_STYLE=path
PORT=8000
WEB_CONCURRENCY=1
GUNICORN_THREADS=4
EMAIL_HOST=replace-smtp-host
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=IRME Telemedicine <no-reply@irme.in>
MARKETING_LEAD_EMAIL=replace-recipient@example.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
VIDEO_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_CALLS_APP_ID=

# First deployment only. Remove these three variables after first successful admin login.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
